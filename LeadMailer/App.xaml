<Application x:Class="LeadMailer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml"/>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Forzar colores de texto del sistema para evitar texto invisible en modo oscuro de Windows 11 -->
            <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}"   Color="#0F172A"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}"  Color="#0F172A"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}"       Color="#FFFFFF"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
