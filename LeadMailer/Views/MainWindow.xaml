<Window x:Class="LeadMailer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LeadMailer.ViewModels"
        xmlns:conv="clr-namespace:LeadMailer.Converters"
        xmlns:beh="clr-namespace:LeadMailer.Behaviors"
        Title="LeadMailer — Automatización de correos"
        Height="780" Width="1280"
        MinHeight="660" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <conv:BoolToVisibilityConverter         x:Key="BoolVis"/>
        <conv:InvertBoolToVisibilityConverter   x:Key="InvBoolVis"/>
        <conv:SentStatusBrushConverter          x:Key="SentBrush"/>
        <conv:LeadStatusBrushConverter          x:Key="LeadStatusBrush"/>
        <conv:DiscardButtonLabelConverter        x:Key="DiscardLabel"/>
        <conv:NullToVisibilityConverter         x:Key="NullVis"/>
        <conv:EmptyStringToVisibilityConverter  x:Key="EmptyStrVis"/>
        <conv:EqualStringConverter              x:Key="EqStrConverter"/>
        <conv:LeadLabelTextConverter            x:Key="LeadLabelText"/>
        <conv:LeadLabelBrushConverter           x:Key="LeadLabelBrush"/>
        <conv:LeadLabelForegroundConverter      x:Key="LeadLabelFg"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" MinWidth="160" MaxWidth="360"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════════════════
             SIDEBAR
        ══════════════════════════════════════════════════════════ -->
        <Border Grid.Column="0" Background="{StaticResource SidebarGradientBrush}">
            <DockPanel LastChildFill="False">

                <!-- Brand -->
                <StackPanel DockPanel.Dock="Top" Margin="22,28,22,20">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="38" Height="38" Background="{StaticResource PrimaryBrush}"
                                CornerRadius="10" Margin="0,0,12,0">
                            <TextBlock Text="✉" FontSize="18" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="LeadMailer" FontSize="18" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="{Binding AppVersion}" FontSize="10" Foreground="#475569"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Border DockPanel.Dock="Top" Height="1" Background="#1E293B" Margin="16,0,16,12"/>

                <!-- Nav section label -->
                <TextBlock DockPanel.Dock="Top" Text="MENÚ PRINCIPAL"
                           FontSize="10" FontWeight="SemiBold" Foreground="#334155"
                           Margin="26,0,0,8"/>

                <!-- Nav buttons -->
                <StackPanel DockPanel.Dock="Top" Margin="10,0">

                    <Button Command="{Binding NavigateCommand}" CommandParameter="Leads">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentView}" Value="Leads">
                                        <Setter Property="Background" Value="#1E3A8A"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid Width="180">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="📋" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Leads" FontSize="13" VerticalAlignment="Center"/>
                            <Border Grid.Column="2" Background="{StaticResource AccentBrush}" CornerRadius="10"
                                    Padding="8,2" Visibility="{Binding PendingCount, Converter={StaticResource NullVis}}">
                                <TextBlock Text="{Binding PendingCount}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </Grid>
                    </Button>

                    <Button Command="{Binding NavigateCommand}" CommandParameter="LegacyCampaigns">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentView}" Value="LegacyCampaigns">
                                        <Setter Property="Background" Value="#1E3A8A"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid Width="180">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🗂" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Leads antiguos" FontSize="13" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button Command="{Binding NavigateCommand}" CommandParameter="Students">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentView}" Value="Students">
                                        <Setter Property="Background" Value="#1E3A8A"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid Width="180">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🎓" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Alumnos" FontSize="13" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button Command="{Binding NavigateCommand}" CommandParameter="History">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentView}" Value="History">
                                        <Setter Property="Background" Value="#1E3A8A"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid Width="180">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🕓" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Historial" FontSize="13" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button Command="{Binding NavigateCommand}" CommandParameter="Courses">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentView}" Value="Courses">
                                        <Setter Property="Background" Value="#1E3A8A"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentView}" Value="CourseEdit">
                                        <Setter Property="Background" Value="#1E3A8A"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid Width="180">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🎓" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Cursos" FontSize="13" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button Command="{Binding NavigateCommand}" CommandParameter="Settings">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentView}" Value="Settings">
                                        <Setter Property="Background" Value="#1E3A8A"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid Width="180">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="⚙" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Configuración" FontSize="13" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Stats bottom -->
                <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,24">
                    <Border Height="1" Background="#1E293B" Margin="0,0,0,16"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding PendingCount}" FontSize="24" FontWeight="Bold"
                                       Foreground="#F59E0B" HorizontalAlignment="Center"/>
                            <TextBlock Text="Pendientes" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding SentCount}" FontSize="24" FontWeight="Bold"
                                       Foreground="#22C55E" HorizontalAlignment="Center"/>
                            <TextBlock Text="Enviados" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding FollowUpTodayCount}" FontSize="24" FontWeight="Bold"
                                       Foreground="#38BDF8" HorizontalAlignment="Center"/>
                            <TextBlock Text="Hoy" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════════════
             CONTENT AREA
        ══════════════════════════════════════════════════════════ -->
        <GridSplitter Grid.Column="1"
                      Width="6"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="#E2E8F0"
                      ShowsPreview="True"
                      ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Columns"/>

        <Grid Grid.Column="2">

            <!-- ─────────────────────────────────────────
                 VIEW: LEADS
            ───────────────────────────────────────── -->
            <DockPanel Margin="28">
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentView}" Value="Leads">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>

                <!-- Page title -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                    <TextBlock Text="Leads" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Carga el Excel diario y envía correos personalizados a cada lead"
                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- File picker -->
                <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="ARCHIVO EXCEL" Style="{StaticResource FieldLabel}" FontSize="11"/>
                            <TextBlock Text="{Binding ExcelFilePath, FallbackValue='Ningún archivo seleccionado'}"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="📂  Examinar"
                                Command="{Binding BrowseExcelCommand}"
                                Style="{StaticResource BtnSecondary}" Margin="0,0,6,0"
                                FontSize="12" Padding="10,6"/>
                        <Button Grid.Column="2" Content="🔄  Cargar"
                                Command="{Binding LoadLeadsCommand}"
                                Style="{StaticResource BtnPrimary}"
                                FontSize="12" Padding="10,6"/>
                    </Grid>
                </Border>

                <!-- Course warning banner -->
                <Border DockPanel.Dock="Top" Background="#FEF3C7" CornerRadius="8" Padding="14,10"
                        Margin="0,0,0,10"
                        Visibility="{Binding HasCourseWarning, Converter={StaticResource BoolVis}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="⚠" FontSize="18" Foreground="#D97706"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button DockPanel.Dock="Right"
                                Content="Ir a Cursos →"
                                Command="{Binding NavigateCommand}" CommandParameter="Courses"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#1D4ED8" FontWeight="SemiBold" FontSize="13" Cursor="Hand"
                                Margin="12,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CourseWarningText}" FontSize="13" Foreground="#92400E"
                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <!-- Action toolbar -->
                <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel Orientation="Vertical">
                        <!-- Primera fila de botones -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="✓  Todos"
                                    Command="{Binding SelectAllCommand}"
                                    Style="{StaticResource BtnSecondary}" Margin="0,0,6,0"
                                    VerticalAlignment="Center" FontSize="12"/>
                            <Button Grid.Column="1" Content="✗  Ninguno"
                                    Command="{Binding DeselectAllCommand}"
                                    Style="{StaticResource BtnSecondary}" Margin="0,0,6,0"
                                    VerticalAlignment="Center" FontSize="12"/>
                            <Button Grid.Column="2" Content="📅  Hoy"
                                    Command="{Binding SelectFollowUpTodayCommand}"
                                    Style="{StaticResource BtnSecondary}" Margin="0,0,6,0"
                                    VerticalAlignment="Center" FontSize="12"
                                    ToolTip="Seleccionar leads con seguimiento para hoy"/>
                            <Button Grid.Column="3" Content="🧹  Limpiar selección"
                                    Command="{Binding ClearSelectedLeadsCommand}"
                                    Style="{StaticResource BtnSecondary}" Margin="0,0,6,0"
                                    VerticalAlignment="Center" FontSize="12"
                                    ToolTip="Quitar solo la selección actual"/>
                            <Button Grid.Column="4" Content="↩  Deshacer"
                                    Command="{Binding UndoLastActionCommand}"
                                    Style="{StaticResource BtnSecondary}" Margin="0,0,6,0"
                                    VerticalAlignment="Center" FontSize="12"
                                    ToolTip="Deshacer última acción crítica"/>
                            <Button Grid.Column="5" Content="🧭  Filtros"
                                    Command="{Binding ToggleLeadsFiltersCommand}"
                                    Style="{StaticResource BtnSecondary}" Margin="0,0,6,0"
                                    VerticalAlignment="Center" FontSize="12"
                                    ToolTip="Mostrar u ocultar filtros y resumen"/>
                            <TextBlock Grid.Column="6" Text="{Binding StatusMessage}"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       Margin="10,0,0,0"/>
                        </Grid>
                        <!-- Segunda fila de botones -->
                        <WrapPanel>
                            <Button Content="💬  WhatsApp"
                                    Command="{Binding SendWhatsAppToSelectedCommand}"
                                    Style="{StaticResource BtnSecondary}" Margin="0,0,6,6"
                                    VerticalAlignment="Center" FontSize="12"
                                    ToolTip="Enviar WhatsApp a seleccionados"/>
                            <Button Content="⭳  CSV"
                                    Command="{Binding ExportFilteredLeadsCommand}"
                                    Style="{StaticResource BtnSecondary}" Margin="0,0,6,6"
                                    VerticalAlignment="Center" FontSize="12"
                                    ToolTip="Exportar a CSV"/>
                            <Button Content="⭳  XLSX"
                                    Command="{Binding ExportFilteredLeadsExcelCommand}"
                                    Style="{StaticResource BtnSecondary}" Margin="0,0,6,6"
                                    VerticalAlignment="Center" FontSize="12"
                                    ToolTip="Exportar a Excel"/>
                            <Button Content="↻  Reintentar"
                                    Command="{Binding RetryFailedCommand}"
                                    Style="{StaticResource BtnSecondary}" Margin="0,0,6,6"
                                    VerticalAlignment="Center" FontSize="12"
                                    ToolTip="Reintentar envíos fallidos"/>
                            <Button Content="🔎  Prevalidar"
                                    Command="{Binding PrevalidateLeadsCommand}"
                                    Style="{StaticResource BtnSecondary}" Margin="0,0,6,6"
                                    VerticalAlignment="Center" FontSize="12"
                                    ToolTip="Validar emails y cursos antes de enviar"/>
                            <Button Content="👥  Duplicados"
                                    Command="{Binding SelectDuplicateLeadsCommand}"
                                    Style="{StaticResource BtnSecondary}" Margin="0,0,6,6"
                                    VerticalAlignment="Center" FontSize="12"
                                    ToolTip="Seleccionar solo leads duplicados"/>
                            <Button Content="✉  Email inválido"
                                    Command="{Binding SelectInvalidEmailLeadsCommand}"
                                    Style="{StaticResource BtnSecondary}" Margin="0,0,6,6"
                                    VerticalAlignment="Center" FontSize="12"
                                    ToolTip="Seleccionar leads con email inválido"/>
                            <Button Content="✅  Listos"
                                    Command="{Binding SelectReadyLeadsCommand}"
                                    Style="{StaticResource BtnSecondary}" Margin="0,0,6,6"
                                    VerticalAlignment="Center" FontSize="12"
                                    ToolTip="Seleccionar solo leads listos para envío"/>
                            <Button Content="⚠  Incidencias"
                                    Command="{Binding SelectIssueLeadsCommand}"
                                    Style="{StaticResource BtnSecondary}" Margin="0,0,6,6"
                                    VerticalAlignment="Center" FontSize="12"
                                    ToolTip="Seleccionar leads con incidencias (duplicado, email inválido o curso sin configurar)"/>
                            <Button Content="⭳  Incidencias CSV"
                                    Command="{Binding ExportLeadIssuesCsvCommand}"
                                    Style="{StaticResource BtnSecondary}" Margin="0,0,6,6"
                                    VerticalAlignment="Center" FontSize="12"
                                    ToolTip="Exportar incidencias de leads filtrados a CSV"/>
                            <Button Content="👁  Previsualizar"
                                    Command="{Binding PreviewSelectedEmailCommand}"
                                    Style="{StaticResource BtnSecondary}" Margin="0,0,6,6"
                                    VerticalAlignment="Center" FontSize="12"
                                    ToolTip="Previsualizar email real del primer lead seleccionado"/>
                            <Button Content="🚀  Enviar"
                                    Command="{Binding SendSelectedCommand}"
                                    Style="{StaticResource BtnSuccess}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvBoolVis}}"
                                    Margin="0,0,6,6"
                                    VerticalAlignment="Center" FontSize="12"/>
                            <Button Content="📋  Copiar emails"
                                    Command="{Binding CopySelectedEmailsCommand}"
                                    Style="{StaticResource BtnSecondary}" Margin="0,0,0,6"
                                    VerticalAlignment="Center" FontSize="12"
                                    ToolTip="Copiar emails seleccionados al portapapeles"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <StackPanel DockPanel.Dock="Top"
                            Visibility="{Binding ShowLeadsFilters, Converter={StaticResource BoolVis}}">
                <!-- ══ BARRA DE FILTROS ══ -->
                <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <WrapPanel>

                        <!-- Búsqueda libre -->
                        <StackPanel Width="320" Margin="0,0,8,8">
                            <TextBlock Text="BUSCAR" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputStyle}" Height="34"/>
                        </StackPanel>

                        <!-- Filtro por curso -->
                        <StackPanel Width="190" Margin="0,0,8,8">
                            <TextBlock Text="CURSO" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding CourseFilterItems}"
                                      SelectedItem="{Binding SelectedCourseFilter}"
                                      DisplayMemberPath="NombreCorto"
                                      Height="34" VerticalContentAlignment="Center" FontSize="12"/>
                        </StackPanel>

                        <!-- Filtro por estado -->
                        <StackPanel Width="150" Margin="0,0,8,8">
                            <TextBlock Text="ESTADO" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding StatusFilterOptions}"
                                      SelectedItem="{Binding SelectedStatusFilter}"
                                      Height="34" VerticalContentAlignment="Center" FontSize="12"/>
                        </StackPanel>

                        <!-- Contador de resultados -->
                        <StackPanel Width="80" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <TextBlock Text="{Binding FilteredCount}" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="resultados" FontSize="9"
                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </WrapPanel>
                </Border>

                <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#FFF7ED" CornerRadius="8" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="Duplicados" FontSize="10" Foreground="#9A3412"/>
                                <TextBlock Text="{Binding LeadIssuesDuplicateCount}" FontSize="24" FontWeight="Bold" Foreground="#9A3412"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#FEF2F2" CornerRadius="8" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="Email inválido" FontSize="10" Foreground="#991B1B"/>
                                <TextBlock Text="{Binding LeadIssuesInvalidEmailCount}" FontSize="24" FontWeight="Bold" Foreground="#991B1B"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Background="#FEF3C7" CornerRadius="8" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="Curso sin configurar" FontSize="10" Foreground="#92400E"/>
                                <TextBlock Text="{Binding LeadIssuesUnconfiguredCourseCount}" FontSize="24" FontWeight="Bold" Foreground="#92400E"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="6" Background="#EFF6FF" CornerRadius="8" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="Total incidencias (filtro actual)" FontSize="10" Foreground="#1E40AF"/>
                                <TextBlock Text="{Binding LeadIssuesTotalCount}" FontSize="24" FontWeight="Bold" Foreground="#1E40AF"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
                </StackPanel>

                <!-- DataGrid -->
                <Border Style="{StaticResource CardStyle}" Padding="0">
                    <DataGrid ItemsSource="{Binding FilteredLeads}"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDuplicate}" Value="True">
                                        <Setter Property="Background" Value="#FFF7ED"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsInvalidEmail}" Value="True">
                                        <Setter Property="Background" Value="#FEF2F2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>

                            <!-- Checkbox -->
                            <DataGridTemplateColumn Header="" Width="46" CanUserResize="False" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanSelect}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Estado badge -->
                            <DataGridTemplateColumn Header="ESTADO" Width="140" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="5" Padding="7,3" HorizontalAlignment="Left"
                                                Background="{Binding Status, Converter={StaticResource LeadStatusBrush}}">
                                            <TextBlock Text="{Binding EstadoTexto}" FontSize="11"
                                                       FontWeight="SemiBold" Foreground="White"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Etiqueta manual -->
                            <DataGridTemplateColumn Header="ETIQUETA" Width="130" CanUserResize="False" CanUserSort="False">
                                <!-- Vista: badge de color siempre visible -->
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="5" Padding="7,3" HorizontalAlignment="Left" Cursor="Hand"
                                                Background="{Binding Label, Converter={StaticResource LeadLabelBrush}}">
                                            <TextBlock Text="{Binding Label, Converter={StaticResource LeadLabelText}}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{Binding Label, Converter={StaticResource LeadLabelFg}}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <!-- Edición (doble-click): ComboBox -->
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.LeadLabelOptions,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedValue="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="Value"
                                                  DisplayMemberPath="Display"
                                                  IsDropDownOpen="True"
                                                  Height="28" FontSize="11" VerticalContentAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="NOMBRE"     Binding="{Binding Nombre}"           Width="150"/>
                            <DataGridTextColumn Header="EMAIL"      Binding="{Binding Email}"            Width="200"/>
                            <DataGridTextColumn Header="TELÉFONO"   Binding="{Binding Telefono}"         Width="130"/>
                            <DataGridTextColumn Header="CURSO"      Binding="{Binding NombreCurso}"      Width="*"/>
                            <DataGridTextColumn Header="PROVINCIA"  Binding="{Binding Provincia}"        Width="100"/>
                            <DataGridTextColumn Header="SIT. LAB."  Binding="{Binding SituacionLaboral}" Width="120"/>
                            <DataGridTemplateColumn Header="LLAMADA" Width="120" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox IsChecked="{Binding PhoneCalled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      VerticalAlignment="Center" Margin="0,0,6,0"
                                                      ToolTip="Marcar si se ha llamado por teléfono"/>
                                            <TextBlock Text="{Binding PhoneCalledAtText}" FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="NOTAS SEGUIMIENTO" Width="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                 Style="{StaticResource InputStyle}"
                                                 Height="30" FontSize="12" Padding="8,0"
                                                 ToolTip="Ej: No contesta, llamar mañana 10:00, interesado en septiembre"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Acciones por fila -->
                            <DataGridTemplateColumn Header="ACCIONES" Width="280" CanUserResize="False" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="2,2">
                                            <Button Content="💬"
                                                    Command="{Binding DataContext.SendWhatsAppCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource BtnSecondary}"
                                                    FontSize="11" Padding="5,2" Margin="0,0,3,0"
                                                    ToolTip="Enviar WhatsApp"/>
                                            <Button Content="👁"
                                                    Command="{Binding DataContext.PreviewLeadEmailCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource BtnSecondary}"
                                                    FontSize="11" Padding="5,2" Margin="0,0,3,0"
                                                    ToolTip="Previsualizar email"/>
                                            <Button Content="↻"
                                                    Command="{Binding DataContext.ResendLeadCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource BtnSecondary}"
                                                    FontSize="11" Padding="5,2" Margin="0,0,3,0"
                                                    ToolTip="Reenviar correo"/>
                                            <Button Content="❌"
                                                    Command="{Binding DataContext.ToggleDiscardLeadCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource BtnSecondary}"
                                                    FontSize="11" Padding="5,2" Margin="0,0,3,0"
                                                    ToolTip="{Binding IsDiscarded, Converter={StaticResource DiscardLabel}}"/>
                                            <Button Content="🗑"
                                                    Command="{Binding DataContext.DeleteLeadCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource BtnSecondary}"
                                                    FontSize="11" Padding="5,2"
                                                    Foreground="#B91C1C" BorderBrush="#FECACA"
                                                    ToolTip="Eliminar lead"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </DockPanel>

            <!-- ─────────────────────────────────────────
                 VIEW: STUDENTS
            ───────────────────────────────────────── -->
            <DockPanel Margin="28">
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentView}" Value="Students">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>

                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                    <TextBlock Text="Alumnos" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Leads confirmados y alumnos añadidos manualmente agrupados por curso"
                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                </StackPanel>

                <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <WrapPanel>
                        <StackPanel Width="220" Margin="0,0,8,8">
                            <TextBlock Text="BUSCAR" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding StudentSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputStyle}" Height="34"/>
                        </StackPanel>
                        <StackPanel Width="220" Margin="0,0,8,8">
                            <TextBlock Text="CURSO" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding StudentCourseFilterOptions}"
                                      SelectedItem="{Binding SelectedStudentCourseFilter}"
                                      Height="34" VerticalContentAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </WrapPanel>
                </Border>

                <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <WrapPanel Margin="0,0,0,6">
                            <Button Content="📧  Avisar por email"
                                    Command="{Binding SendStudentsEmailsCommand}"
                                    Style="{StaticResource BtnSuccess}"
                                    Margin="0,0,6,6" FontSize="12"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvBoolVis}}"/>
                            <Button Content="💬  WhatsApp"
                                    Command="{Binding SendStudentsWhatsAppCommand}"
                                    Style="{StaticResource BtnSecondary}"
                                    Margin="0,0,6,6" FontSize="12"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvBoolVis}}"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="ALTA MANUAL DE ALUMNO" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="Abre una ventana para añadir un alumno y mantener más espacio para el grid"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="➕  Nuevo alumno"
                                Command="{Binding OpenAddStudentDialogCommand}"
                                Style="{StaticResource BtnPrimary}" Padding="12,6"
                                VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Grid>
                    <Border Style="{StaticResource CardStyle}" Padding="0">
                        <DataGrid ItemsSource="{Binding FilteredStudents}"
                                  CanUserResizeColumns="True"
                                  CanUserSortColumns="True"
                                  RowDetailsVisibilityMode="VisibleWhenSelected">
                            <DataGrid.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <Border Background="#EFF6FF" CornerRadius="6" Padding="8,4" Margin="0,6,0,4">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#1E40AF"/>
                                            </Border>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </DataGrid.GroupStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="NOMBRE" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource InputStyle}" Height="30" Padding="8,0"
                                                     IsReadOnly="{Binding IsLinkedToLead}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="EMAIL" Width="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource InputStyle}" Height="30" Padding="8,0"
                                                     IsReadOnly="{Binding IsLinkedToLead}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="TELÉFONO" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource InputStyle}" Height="30" Padding="8,0"
                                                     IsReadOnly="{Binding IsLinkedToLead}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="CURSO" Width="220">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Curso, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource InputStyle}" Height="30" Padding="8,0"
                                                     IsReadOnly="{Binding IsLinkedToLead}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="ORIGEN" Binding="{Binding Origin}" Width="130" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="ACCIONES" Width="120" CanUserResize="False" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="🗑"
                                                    Command="{Binding DataContext.DeleteStudentCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource BtnSecondary}"
                                                    IsEnabled="{Binding IsManual}"
                                                    Foreground="#B91C1C" BorderBrush="#FECACA"
                                                    FontSize="11" Padding="5,2"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                            <DataGrid.RowDetailsTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC" Padding="10" CornerRadius="6" Margin="6">
                                        <WrapPanel>
                                            <StackPanel Width="180" Margin="0,0,12,8">
                                                <TextBlock Text="PLATAFORMA" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Text="{Binding Plataforma, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource InputStyle}" Height="30" Padding="8,0"
                                                         IsReadOnly="{Binding IsLinkedToLead}"/>
                                            </StackPanel>
                                            <StackPanel Width="180" Margin="0,0,12,8">
                                                <TextBlock Text="SIT. LAB." Style="{StaticResource FieldLabel}"/>
                                                <TextBox Text="{Binding SituacionLaboral, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource InputStyle}" Height="30" Padding="8,0"
                                                         IsReadOnly="{Binding IsLinkedToLead}"/>
                                            </StackPanel>
                                            <StackPanel Width="180" Margin="0,0,12,8">
                                                <TextBlock Text="NIVEL" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Text="{Binding NivelEstudios, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource InputStyle}" Height="30" Padding="8,0"
                                                         IsReadOnly="{Binding IsLinkedToLead}"/>
                                            </StackPanel>
                                            <StackPanel Width="160" Margin="0,0,12,8">
                                                <TextBlock Text="PROVINCIA" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Text="{Binding Provincia, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource InputStyle}" Height="30" Padding="8,0"
                                                         IsReadOnly="{Binding IsLinkedToLead}"/>
                                            </StackPanel>
                                            <StackPanel Width="200" Margin="0,0,12,8">
                                                <TextBlock Text="OBSERVACIONES" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Text="{Binding Observaciones, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource InputStyle}" Height="30" Padding="8,0"
                                                         IsReadOnly="{Binding IsLinkedToLead}"/>
                                            </StackPanel>
                                            <StackPanel Width="200" Margin="0,0,12,8">
                                                <TextBlock Text="CONTACTO" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Text="{Binding Contacto, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource InputStyle}" Height="30" Padding="8,0"
                                                         IsReadOnly="{Binding IsLinkedToLead}"/>
                                            </StackPanel>
                                            <StackPanel Width="200" Margin="0,0,12,8">
                                                <TextBlock Text="INSCRIPCIÓN" Style="{StaticResource FieldLabel}"/>
                                                <TextBox Text="{Binding Inscripcion, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource InputStyle}" Height="30" Padding="8,0"
                                                         IsReadOnly="{Binding IsLinkedToLead}"/>
                                            </StackPanel>
                                            <StackPanel Width="140" Margin="0,0,12,8">
                                                <TextBlock Text="FECHA REG." Style="{StaticResource FieldLabel}"/>
                                                <TextBox Text="{Binding FechaRegistro, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource InputStyle}" Height="30" Padding="8,0"
                                                         IsReadOnly="{Binding IsLinkedToLead}"/>
                                            </StackPanel>
                                            <StackPanel Width="120" Margin="0,0,12,8" VerticalAlignment="Bottom">
                                                <TextBlock Text="PUBLICIDAD" Style="{StaticResource FieldLabel}"/>
                                                <CheckBox IsChecked="{Binding AceptaPublicidad, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEnabled="{Binding IsManual}"/>
                                            </StackPanel>
                                        </WrapPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGrid.RowDetailsTemplate>
                        </DataGrid>
                    </Border>

                    <Border Background="#A0000000"
                            Visibility="{Binding IsAddStudentDialogOpen, Converter={StaticResource BoolVis}}">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="980" MaxWidth="980">
                        <Border Style="{StaticResource CardStyle}" Padding="18" MaxHeight="700">
                            <DockPanel LastChildFill="True">
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Añadir alumno manual" FontSize="20" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Completa al menos nombre y curso" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="✕"
                                            Command="{Binding CancelAddStudentDialogCommand}"
                                            Style="{StaticResource BtnSecondary}" Padding="10,4"/>
                                </Grid>

                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <Button Content="Cancelar"
                                            Command="{Binding CancelAddStudentDialogCommand}"
                                            Style="{StaticResource BtnSecondary}" Margin="0,0,8,0" Padding="12,6"/>
                                    <Button Content="➕  Añadir alumno"
                                            Command="{Binding AddStudentCommand}"
                                            Style="{StaticResource BtnPrimary}" Padding="12,6"/>
                                </StackPanel>

                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <WrapPanel>
                                    <StackPanel Width="180" Margin="0,0,8,8">
                                        <TextBlock Text="NOMBRE" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding NewStudentNombre, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Height="34"/>
                                    </StackPanel>
                                    <StackPanel Width="200" Margin="0,0,8,8">
                                        <TextBlock Text="EMAIL" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding NewStudentEmail, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Height="34"/>
                                    </StackPanel>
                                    <StackPanel Width="130" Margin="0,0,8,8">
                                        <TextBlock Text="TELÉFONO" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding NewStudentTelefono, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Height="34"/>
                                    </StackPanel>
                                    <StackPanel Width="200" Margin="0,0,8,8">
                                        <TextBlock Text="CURSO" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding NewStudentCurso, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Height="34"/>
                                    </StackPanel>
                                    <StackPanel Width="140" Margin="0,0,8,8">
                                        <TextBlock Text="FECHA REG." Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding NewStudentFechaRegistro, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Height="34"/>
                                    </StackPanel>
                                    <StackPanel Width="160" Margin="0,0,8,8">
                                        <TextBlock Text="PROVINCIA" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding NewStudentProvincia, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Height="34"/>
                                    </StackPanel>
                                    <StackPanel Width="160" Margin="0,0,8,8">
                                        <TextBlock Text="PLATAFORMA" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding NewStudentPlataforma, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Height="34"/>
                                    </StackPanel>
                                    <StackPanel Width="160" Margin="0,0,8,8">
                                        <TextBlock Text="SIT. LAB." Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding NewStudentSituacionLaboral, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Height="34"/>
                                    </StackPanel>
                                    <StackPanel Width="160" Margin="0,0,8,8">
                                        <TextBlock Text="NIVEL ESTUDIOS" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding NewStudentNivelEstudios, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Height="34"/>
                                    </StackPanel>
                                    <StackPanel Width="220" Margin="0,0,8,8">
                                        <TextBlock Text="OBSERVACIONES" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding NewStudentObservaciones, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Height="34"/>
                                    </StackPanel>
                                    <StackPanel Width="200" Margin="0,0,8,8">
                                        <TextBlock Text="CONTACTO" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding NewStudentContacto, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Height="34"/>
                                    </StackPanel>
                                    <StackPanel Width="200" Margin="0,0,8,8">
                                        <TextBlock Text="INSCRIPCIÓN" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding NewStudentInscripcion, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" Height="34"/>
                                    </StackPanel>
                                    <StackPanel Width="140" Margin="0,0,8,8">
                                        <TextBlock Text="PUBLICIDAD" Style="{StaticResource FieldLabel}"/>
                                        <CheckBox IsChecked="{Binding NewStudentAceptaPublicidad}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    </WrapPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                    </Border>
                </Grid>
            </DockPanel>

            <!-- ─────────────────────────────────────────
                 VIEW: LEGACY CAMPAIGNS
            ───────────────────────────────────────── -->
            <DockPanel Margin="28">
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentView}" Value="LegacyCampaigns">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>

                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                    <TextBlock Text="Campañas sobre leads antiguos" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Carga un Excel histórico, filtra y lanza campañas por email o WhatsApp usando un curso ya configurado"
                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                </StackPanel>

                <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Margin="0,0,0,12"
                        Visibility="{Binding ShowLegacyFilters, Converter={StaticResource BoolVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="EXCEL HISTÓRICO" Style="{StaticResource FieldLabel}" FontSize="11"/>
                            <TextBlock Text="{Binding LegacyExcelFilePath, FallbackValue='Ningún archivo seleccionado'}"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="📂  Examinar"
                                Command="{Binding BrowseLegacyExcelCommand}"
                                Style="{StaticResource BtnSecondary}" Margin="0,0,6,0"
                                FontSize="12" Padding="10,6"/>
                        <Button Grid.Column="2" Content="🔄  Cargar"
                                Command="{Binding LoadLegacyLeadsCommand}"
                                Style="{StaticResource BtnPrimary}"
                                FontSize="12" Padding="10,6"/>
                    </Grid>
                </Border>

                <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Margin="0,0,0,12"
                        Visibility="{Binding ShowLegacyFilters, Converter={StaticResource BoolVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="320"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="CURSO A ENVIAR EN LA CAMPAÑA" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="Selecciona un curso ya configurado. Ese contenido se usará para todos los leads seleccionados."
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,6"/>
                            <ComboBox ItemsSource="{Binding Courses}"
                                      SelectedItem="{Binding LegacySelectedCampaignCourse}"
                                      DisplayMemberPath="NombreCorto"
                                      Height="34" VerticalContentAlignment="Center" FontSize="12"/>
                        </StackPanel>

                        <Border Grid.Column="2" Background="#EFF6FF" CornerRadius="8" Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="Seleccionados" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding LegacySelectedCount}" FontSize="28" FontWeight="Bold" Foreground="#1D4ED8" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding LegacyFilteredCount, StringFormat=Filtrados: {0}}" FontSize="11" Foreground="#1E40AF" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <WrapPanel>

                        <StackPanel Width="320" Margin="0,0,8,8">
                            <TextBlock Text="BUSCAR" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding LegacySearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputStyle}" Height="34"
                                     ToolTip="Busca por nombre, email, teléfono, provincia, situación laboral o curso de origen"/>
                        </StackPanel>

                        <StackPanel Width="220" Margin="0,0,8,8">
                            <TextBlock Text="CURSO ORIGEN" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding LegacyOriginCourseFilterOptions}"
                                      SelectedItem="{Binding LegacyOriginCourseFilter}"
                                      Height="34" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Width="180" Margin="0,0,8,8">
                            <TextBlock Text="PROVINCIA" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding LegacyProvinceFilterOptions}"
                                      SelectedItem="{Binding LegacyProvinceFilter}"
                                      Height="34" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Width="220" Margin="0,0,8,8">
                            <TextBlock Text="SITUACIÓN LABORAL" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding LegacyEmploymentFilterOptions}"
                                      SelectedItem="{Binding LegacyEmploymentFilter}"
                                      Height="34" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Width="170" VerticalAlignment="Bottom" Margin="0,0,8,8">
                            <CheckBox Content="Solo acepta publicidad"
                                      IsChecked="{Binding LegacyOnlyWithPublicidad}"
                                      FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel Width="140" VerticalAlignment="Bottom" Margin="0,0,8,8">
                            <CheckBox Content="Solo duplicados"
                                      IsChecked="{Binding LegacyOnlyDuplicates}"
                                      FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel Width="150" VerticalAlignment="Bottom" Margin="0,0,8,8">
                            <CheckBox Content="Solo email inválido"
                                      IsChecked="{Binding LegacyOnlyInvalidEmail}"
                                      FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel Width="130" VerticalAlignment="Bottom" Margin="0,0,0,8">
                            <CheckBox Content="Solo incidencias"
                                      IsChecked="{Binding LegacyOnlyIssues}"
                                      FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </WrapPanel>
                </Border>

                <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <WrapPanel Margin="0,0,0,6">
                            <Button Content="✓  Todos" Command="{Binding SelectAllLegacyCommand}"
                                    Style="{StaticResource BtnSecondary}" Margin="0,0,6,6" FontSize="12"/>
                            <Button Content="✗  Ninguno" Command="{Binding DeselectAllLegacyCommand}"
                                    Style="{StaticResource BtnSecondary}" Margin="0,0,6,6" FontSize="12"/>
                            <Button Content="🧹  Limpiar selección" Command="{Binding ClearSelectedLegacyCommand}"
                                    Style="{StaticResource BtnSecondary}" Margin="0,0,6,6" FontSize="12"/>
                            <Button Content="👥  Duplicados" Command="{Binding SelectDuplicateLegacyCommand}"
                                    Style="{StaticResource BtnSecondary}" Margin="0,0,6,6" FontSize="12"/>
                            <Button Content="✉  Email inválido" Command="{Binding SelectInvalidEmailLegacyCommand}"
                                    Style="{StaticResource BtnSecondary}" Margin="0,0,6,6" FontSize="12"/>
                            <Button Content="✅  Listos" Command="{Binding SelectReadyLegacyCommand}"
                                    Style="{StaticResource BtnSecondary}" Margin="0,0,6,6" FontSize="12"/>
                            <Button Content="⚠  Incidencias" Command="{Binding SelectIssueLegacyCommand}"
                                    Style="{StaticResource BtnSecondary}" Margin="0,0,6,6" FontSize="12"/>
                            <Button Content="⭳  Incidencias CSV" Command="{Binding ExportLegacyIssuesCsvCommand}"
                                    Style="{StaticResource BtnSecondary}" Margin="0,0,6,6" FontSize="12"/>
                            <Button Content="🔎  Prevalidar" Command="{Binding PrevalidateLegacyLeadsCommand}"
                                    Style="{StaticResource BtnSecondary}" Margin="0,0,6,6" FontSize="12"/>
                            <Button Content="🚀  Enviar email" Command="{Binding SendLegacySelectedEmailsCommand}"
                                    Style="{StaticResource BtnSuccess}" Margin="0,0,6,6" FontSize="12"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvBoolVis}}"/>
                            <Button Content="💬  WhatsApp" Command="{Binding SendLegacyWhatsAppToSelectedCommand}"
                                    Style="{StaticResource BtnSecondary}" Margin="0,0,6,6" FontSize="12"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvBoolVis}}"/>
                            <Button Content="📋  Copiar emails" Command="{Binding CopySelectedLegacyEmailsCommand}"
                                    Style="{StaticResource BtnSecondary}" Margin="0,0,6,6" FontSize="12"
                                    ToolTip="Copiar emails seleccionados de leads antiguos"/>
                            <Button Content="🧭  Filtros" Command="{Binding ToggleLegacyFiltersCommand}"
                                    Style="{StaticResource BtnSecondary}" Margin="0,0,0,6" FontSize="12"
                                    ToolTip="Mostrar u ocultar filtros y resumen"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Margin="0,0,0,12"
                        Visibility="{Binding ShowLegacyFilters, Converter={StaticResource BoolVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#FFF7ED" CornerRadius="8" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="Duplicados" FontSize="10" Foreground="#9A3412"/>
                                <TextBlock Text="{Binding LegacyIssuesDuplicateCount}" FontSize="24" FontWeight="Bold" Foreground="#9A3412"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#FEF2F2" CornerRadius="8" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="Email inválido" FontSize="10" Foreground="#991B1B"/>
                                <TextBlock Text="{Binding LegacyIssuesInvalidEmailCount}" FontSize="24" FontWeight="Bold" Foreground="#991B1B"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Background="#FEF3C7" CornerRadius="8" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="Incidencia curso campaña" FontSize="10" Foreground="#92400E"/>
                                <TextBlock Text="{Binding LegacyIssuesCampaignCourseCount}" FontSize="24" FontWeight="Bold" Foreground="#92400E"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="6" Background="#EFF6FF" CornerRadius="8" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="Total incidencias (filtro actual)" FontSize="10" Foreground="#1E40AF"/>
                                <TextBlock Text="{Binding LegacyIssuesTotalCount}" FontSize="24" FontWeight="Bold" Foreground="#1E40AF"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}" Padding="0">
                    <DataGrid ItemsSource="{Binding FilteredLegacyLeads}" CanUserResizeColumns="True" CanUserSortColumns="True">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDuplicate}" Value="True">
                                        <Setter Property="Background" Value="#FFF7ED"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsInvalidEmail}" Value="True">
                                        <Setter Property="Background" Value="#FEF2F2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="42" CanUserResize="False" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanSelect}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="ESTADO" Width="120" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="5" Padding="7,3" HorizontalAlignment="Left"
                                                Background="{Binding Status, Converter={StaticResource LeadStatusBrush}}">
                                            <TextBlock Text="{Binding EstadoTexto}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="NOMBRE" Binding="{Binding Nombre}" Width="170"/>
                            <DataGridTextColumn Header="EMAIL" Binding="{Binding Email}" Width="220"/>
                            <DataGridTextColumn Header="CURSO AL QUE SE APUNTÓ" Binding="{Binding Lead.Curso}" Width="260"/>
                            <DataGridTextColumn Header="TELÉFONO" Binding="{Binding Telefono}" Width="130"/>
                            <DataGridTextColumn Header="PROVINCIA" Binding="{Binding Provincia}" Width="120"/>
                            <DataGridTextColumn Header="SIT. LAB." Binding="{Binding SituacionLaboral}" Width="130"/>
                            <DataGridTemplateColumn Header="LLAMADA" Width="120" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox IsChecked="{Binding PhoneCalled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      VerticalAlignment="Center" Margin="0,0,6,0"
                                                      ToolTip="Marcar si se ha llamado por teléfono"/>
                                            <TextBlock Text="{Binding PhoneCalledAtText}" FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridCheckBoxColumn Header="DUPL." Binding="{Binding IsDuplicate}" Width="70"/>
                            <DataGridCheckBoxColumn Header="EMAIL INV." Binding="{Binding IsInvalidEmail}" Width="85"/>
                            <DataGridCheckBoxColumn Header="ACEPTA PUB." Binding="{Binding Lead.AceptaPublicidad}" Width="95"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </DockPanel>

            <!-- ─────────────────────────────────────────
                 VIEW: HISTORY
            ───────────────────────────────────────── -->
            <DockPanel Margin="28">
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentView}" Value="History">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>

                <Grid DockPanel.Dock="Top" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Historial de envíos" FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Revisa enviados, fallidos y errores para seguimiento comercial"
                                   FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="⭳  Exportar CSV"
                            Command="{Binding ExportHistoryCsvCommand}"
                            Style="{StaticResource BtnSecondary}" VerticalAlignment="Center"/>
                    <Button Grid.Column="3" Content="🧹  Limpiar historial"
                            Command="{Binding ClearHistoryCommand}"
                            Style="{StaticResource BtnSecondary}" VerticalAlignment="Center"/>
                </Grid>

                <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#DCFCE7" CornerRadius="8" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="Correctos" FontSize="10" Foreground="#166534"/>
                                <TextBlock Text="{Binding HistorySuccessCount}" FontSize="24" FontWeight="Bold" Foreground="#166534"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#FEE2E2" CornerRadius="8" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="Fallidos" FontSize="10" Foreground="#991B1B"/>
                                <TextBlock Text="{Binding HistoryFailedCount}" FontSize="24" FontWeight="Bold" Foreground="#991B1B"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="TOP CURSOS (últimos envíos registrados)" Style="{StaticResource FieldLabel}"/>
                            <ItemsControl ItemsSource="{Binding HistoryCourseMetrics}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Curso}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                       Text="{Binding Total, StringFormat=Total: {0}}"/>
                                            <TextBlock Grid.Column="2" Margin="10,0,0,0" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                       Text="{Binding SuccessRate, StringFormat=Éxito: {0:F0}%}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#EFF6FF" CornerRadius="8" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="Hoy" FontSize="10" Foreground="#1E40AF"/>
                                <TextBlock Text="{Binding HistoryTodayCount}" FontSize="24" FontWeight="Bold" Foreground="#1E40AF"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#EEF2FF" CornerRadius="8" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="Últimos 7 días" FontSize="10" Foreground="#3730A3"/>
                                <TextBlock Text="{Binding HistoryLast7DaysCount}" FontSize="24" FontWeight="Bold" Foreground="#3730A3"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Background="#F5F3FF" CornerRadius="8" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="Últimos 30 días" FontSize="10" Foreground="#6B21A8"/>
                                <TextBlock Text="{Binding HistoryLast30DaysCount}" FontSize="24" FontWeight="Bold" Foreground="#6B21A8"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="BUSCAR" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding HistorySearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputStyle}" Height="34"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="ESTADO" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding HistoryStatusFilterOptions}"
                                      SelectedItem="{Binding HistoryStatusFilter}"
                                      Height="34" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="DESDE" Style="{StaticResource FieldLabel}"/>
                            <DatePicker SelectedDate="{Binding HistoryFromDate}" Height="34"/>
                        </StackPanel>

                        <StackPanel Grid.Column="6">
                            <TextBlock Text="HASTA" Style="{StaticResource FieldLabel}"/>
                            <DatePicker SelectedDate="{Binding HistoryToDate}" Height="34"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="0">
                    <DataGrid ItemsSource="{Binding FilteredHistory}" CanUserResizeColumns="True" CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="FECHA" Binding="{Binding FechaEnvio, StringFormat=dd/MM/yyyy HH:mm}" Width="140"/>
                            <DataGridTextColumn Header="NOMBRE" Binding="{Binding NombreLead}" Width="170"/>
                            <DataGridTextColumn Header="EMAIL" Binding="{Binding Email}" Width="220"/>
                            <DataGridTextColumn Header="CURSO" Binding="{Binding CursoRaw}" Width="*"/>
                            <DataGridTemplateColumn Header="RESULTADO" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="5" Padding="7,3" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#DCFCE7"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Success}" Value="False">
                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Correcto"/>
                                                        <Setter Property="Foreground" Value="#166534"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Success}" Value="False">
                                                                <Setter Property="Text" Value="Fallido"/>
                                                                <Setter Property="Foreground" Value="#991B1B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="ERROR" Binding="{Binding Error}" Width="260"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </DockPanel>

            <!-- ─────────────────────────────────────────
                 VIEW: COURSES LIST
            ───────────────────────────────────────── -->
            <DockPanel Margin="28">
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentView}" Value="Courses">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>

                <Grid DockPanel.Dock="Top" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Cursos" FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Configura la información de cada curso para los correos automáticos"
                                   FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="🧹  Borrar sin configurar"
                            Command="{Binding DeleteUnconfiguredCoursesCommand}"
                            Style="{StaticResource BtnSecondary}"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0"
                            ToolTip="Eliminar de una vez los cursos sin contenido de marketing"/>
                </Grid>

                <!-- Empty state -->
                <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}"
                        Visibility="{Binding Courses.Count, Converter={StaticResource NullVis}, FallbackValue=Visible}">
                    <!-- This border shows only when 0 items; use code-behind trick or always show scroll -->
                </Border>

                <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Empty placeholder -->
                        <Border Margin="0,0,0,0">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Courses.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" Margin="0,48">
                                <TextBlock Text="🎓" FontSize="52" HorizontalAlignment="Center"/>
                                <TextBlock Text="No hay cursos registrados" FontSize="17" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,14,0,6"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Carga un Excel con leads para detectar cursos automáticamente"
                                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Courses wrap panel -->
                        <ItemsControl ItemsSource="{Binding Courses}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardStyle}" Width="310" Margin="0,0,16,16">
                                        <DockPanel LastChildFill="False">
                                            <!-- Header gradient -->
                                            <Border DockPanel.Dock="Top"
                                                    Background="{StaticResource PrimaryGradientBrush}"
                                                    CornerRadius="8" Padding="14,12" Margin="-4,-4,-4,14">
                                                <TextBlock Text="{Binding NombreCorto}" FontSize="13"
                                                           FontWeight="SemiBold" Foreground="White"
                                                           TextWrapping="Wrap" MaxHeight="58"/>
                                            </Border>
                                            <!-- Info -->
                                            <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Inicio:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding FechaInicio, FallbackValue='—'}" FontSize="12"/>
                                            </Grid>
                                            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Fin:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding FechaFin, FallbackValue='—'}" FontSize="12"/>
                                            </Grid>
                                            <!-- Badge -->
                                            <Border DockPanel.Dock="Top" CornerRadius="5" Padding="8,4"
                                                    HorizontalAlignment="Left" Margin="0,0,0,14">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#DCFCE7"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TextoMarketing}" Value="">
                                                                <Setter Property="Background" Value="#FEF3C7"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="11" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="✓ Configurado"/>
                                                            <Setter Property="Foreground" Value="#166534"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding TextoMarketing}" Value="">
                                                                    <Setter Property="Text" Value="⚠ Sin configurar"/>
                                                                    <Setter Property="Foreground" Value="#92400E"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <!-- Edit/Delete buttons -->
                                            <Grid DockPanel.Dock="Top">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition/>
                                                </Grid.ColumnDefinitions>

                                                <Button Grid.Column="0" Content="✏  Editar curso"
                                                        Style="{StaticResource BtnPrimary}"
                                                        HorizontalAlignment="Stretch"
                                                        Command="{Binding DataContext.EditCourseCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>

                                                <Button Grid.Column="2" Content="🗑  Eliminar"
                                                        Style="{StaticResource BtnSecondary}"
                                                        HorizontalAlignment="Stretch"
                                                        Foreground="#B91C1C"
                                                        BorderBrush="#FECACA"
                                                        Command="{Binding DataContext.DeleteCourseCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!-- ─────────────────────────────────────────
                 VIEW: COURSE EDIT
            ───────────────────────────────────────── -->
            <DockPanel Margin="28">
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentView}" Value="CourseEdit">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>

                <!-- Edit header -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Editar curso" FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding EditingCourse.NombreCorto}"
                                   FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="✗  Cancelar" Command="{Binding CancelEditCommand}"
                                Style="{StaticResource BtnSecondary}" Margin="0,0,10,0"/>
                        <Button Content="💾  Guardar cambios" Command="{Binding SaveCourseCommand}"
                                Style="{StaticResource BtnSuccess}"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Nombre + Asunto -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="NOMBRE CORTO DEL CURSO" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding EditingCourse.NombreCorto, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputStyle}" Height="38"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="ASUNTO DEL EMAIL" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding EditingCourse.AsuntoEmail, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputStyle}" Height="38"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                                    <TextBlock Text="NOMBRE COMPLEMENTARIO (SE USA EN EL EMAIL)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding EditingCourse.NombreComplementario, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputStyle}" Height="38"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Fechas + horario -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/><ColumnDefinition Width="18"/>
                                    <ColumnDefinition/><ColumnDefinition Width="18"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="FECHA DE INICIO" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding EditingCourse.FechaInicio, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputStyle}" Height="38"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="FECHA DE FIN" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding EditingCourse.FechaFin, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputStyle}" Height="38"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="HORARIO / MODALIDAD" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding EditingCourse.HorarioInfo, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputStyle}" Height="38"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Texto marketing + Gemini -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <!-- Header row -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="TEXTO DE MARKETING (aparece en el cuerpo del email)"
                                               Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0"/>
                                    <!-- Gemini button -->
                                    <Button Grid.Column="1"
                                            Command="{Binding GenerateMarketingTextCommand}"
                                            IsEnabled="{Binding IsGenerating, Converter={StaticResource InvBoolVis}}"
                                            Cursor="Hand" BorderThickness="0" Padding="14,8">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#4285F4" Offset="0"/>
                                                            <GradientStop Color="#0EA5E9" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <StackPanel Orientation="Horizontal">
                                                        <!-- Google G icon approximation -->
                                                        <Border Width="18" Height="18" CornerRadius="9"
                                                                Background="White" Margin="0,0,7,0">
                                                            <TextBlock Text="G" FontSize="11" FontWeight="Bold"
                                                                       Foreground="#4285F4"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock VerticalAlignment="Center" FontSize="12"
                                                                   FontWeight="SemiBold" Foreground="White">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="Generar con Gemini ✨"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsGenerating}" Value="True">
                                                                            <Setter Property="Text" Value="Generando…"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Opacity" Value="0.88"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Opacity" Value="0.55"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>

                                <!-- Error banner -->
                                <Border Background="#FEF2F2" CornerRadius="7" Padding="12,8" Margin="0,0,0,8"
                                        Visibility="{Binding HasGeminiError, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="{Binding GeminiError}" FontSize="12"
                                               Foreground="#991B1B" TextWrapping="Wrap"/>
                                </Border>

                                <!-- Generating animation -->
                                <Border Background="#EFF6FF" CornerRadius="7" Padding="12,10" Margin="0,0,0,8"
                                        Visibility="{Binding IsGenerating, Converter={StaticResource BoolVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✨" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Gemini está redactando el texto de marketing…"
                                                   FontSize="13" Foreground="#1E40AF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Text area -->
                                <RichTextBox Height="130"
                                             MinHeight="90"
                                             BorderBrush="{StaticResource BorderBrush}"
                                             BorderThickness="1"
                                             Background="White"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             FontSize="13"
                                             Padding="10,8"
                                             VerticalScrollBarVisibility="Auto"
                                             beh:RichTextBoxBindingBehavior.DocumentXaml="{Binding EditingCourse.TextoMarketingRich, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <!-- Hint -->
                                <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource TextMutedBrush}">
                                    Gemini usará el nombre del curso, fechas, horario y requisitos que hayas rellenado arriba para generar el texto.
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Texto aviso inicio de curso -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="TEXTO AVISO INICIO DE CURSO" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
                                <TextBlock Text="Mensaje que se usa al avisar a alumnos confirmados" Style="{StaticResource FieldLabel}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                <TextBox Text="{Binding CourseStartMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextAreaStyle}" Height="80"
                                         ToolTip="Usa {nombre} y {curso} como variables. Ejemplo: 'Hola {nombre}, el curso {curso} empieza pronto'"/>
                                <TextBlock Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource TextMutedBrush}">
                                    💡 Deja vacío para usar el mensaje de WhatsApp o el texto genérico.
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Texto para WhatsApp -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="TEXTO PARA WHATSAPP" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
                                <TextBlock Text="Mensaje personalizado que aparecerá al abrir WhatsApp desde los leads" Style="{StaticResource FieldLabel}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                <TextBox Text="{Binding WhatsappMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextAreaStyle}" Height="80"
                                         ToolTip="Usa {nombre} y {curso} como variables. Ejemplo: 'Hola {nombre}, información sobre {curso}'"/>
                                <!-- Hint -->
                                <TextBlock Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource TextMutedBrush}">
                                    💡 Deja vacío para usar el mensaje genérico. Usa {nombre} para el nombre del lead y {curso} para el nombre del curso.
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Texto para redes sociales -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="TEXTO PARA REDES SOCIALES" Style="{StaticResource FieldLabel}"/>
                                        <TextBlock Text="Copia el texto o abre LinkedIn/Facebook para publicar" Style="{StaticResource FieldLabel}"
                                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <Button Content="🧠  Usar marketing" Command="{Binding UseMarketingAsSocialCommand}"
                                                Style="{StaticResource BtnSecondary}" Margin="0,0,6,0" FontSize="12"/>
                                        <Button Content="📋  Copiar" Command="{Binding CopySocialTextCommand}"
                                                Style="{StaticResource BtnSecondary}" Margin="0,0,6,0" FontSize="12"/>
                                        <Button Content="in  LinkedIn" Command="{Binding OpenLinkedInCommand}"
                                                Style="{StaticResource BtnSecondary}" Margin="0,0,6,0" FontSize="12"/>
                                        <Button Content="f  Facebook" Command="{Binding OpenFacebookCommand}"
                                                Style="{StaticResource BtnSecondary}" FontSize="12"/>
                                    </WrapPanel>
                                </Grid>
                                <TextBox Text="{Binding SocialMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextAreaStyle}" Height="90"
                                         ToolTip="Texto pensado para redes sociales"/>
                            </StackPanel>
                        </Border>

                        <!-- Requisitos + Documentación -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="REQUISITOS DE ACCESO" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding EditingCourse.RequisitosAcceso, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource TextAreaStyle}" Height="100"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="DOCUMENTACIÓN NECESARIA" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding EditingCourse.DocumentacionNecesaria, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource TextAreaStyle}" Height="100"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- URL inscripción + Info adicional -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="URL DISEÑO FORMATIVO OFICIAL" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding EditingCourse.UrlFichaInscripcion, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputStyle}" Height="38"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="INFORMACIÓN ADICIONAL" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding EditingCourse.InfoAdicional, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource TextAreaStyle}" Height="100"/>
                                </StackPanel>

                                <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="PDF ADJUNTO (DISEÑO FORMATIVO OFICIAL)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding EditingCourse.PdfAdjuntoPath, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputStyle}" Height="38"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                        <Button Content="📎  Seleccionar PDF"
                                                Command="{Binding BrowseCoursePdfCommand}"
                                                Style="{StaticResource BtnSecondary}"/>
                                        <Button Content="🧹  Quitar"
                                                Command="{Binding ClearCoursePdfCommand}"
                                                Style="{StaticResource BtnSecondary}"
                                                Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Referencia Excel (readonly) -->
                        <Border Background="#F8FAFC" CornerRadius="10" Padding="16,12" Margin="0,0,0,14"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="REFERENCIA EXCEL (solo lectura)" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding EditingCourse.CursoRaw}" FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!-- ─────────────────────────────────────────
                 VIEW: SETTINGS
            ───────────────────────────────────────── -->
            <DockPanel Margin="28">
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentView}" Value="Settings">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>

                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                    <TextBlock Text="Configuración SMTP" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Configura el servidor de correo para los envíos automáticos"
                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                </StackPanel>

                <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="640" HorizontalAlignment="Left">

                        <!-- Server settings -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="SERVIDOR Y PUERTO" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="130"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="HOST SMTP" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding SmtpConfig.Host, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputStyle}" Height="38"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="PUERTO" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding SmtpConfig.Port, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputStyle}" Height="38"/>
                                    </StackPanel>
                                </Grid>
                                <CheckBox Content="Usar TLS/SSL (recomendado)"
                                          IsChecked="{Binding SmtpConfig.EnableSsl}"
                                          FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="PAUSA ENTRE ENVÍOS (ms)" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding SmtpConfig.SendDelayMs, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputStyle}" Width="120" Height="34"/>
                                </StackPanel>

                                <CheckBox Content="Confirmar antes de envío masivo"
                                          IsChecked="{Binding SmtpConfig.ConfirmMassSend}"
                                          FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,10,0,0"/>

                                <CheckBox Content="Programar envíos"
                                          IsChecked="{Binding SmtpConfig.EnableScheduledSend}"
                                          FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,10,0,0"/>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="FECHA PROGRAMADA" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <DatePicker SelectedDate="{Binding SmtpConfig.ScheduledSendAt}" Height="34" Width="180"/>
                                </StackPanel>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="LÍMITE POR SESIÓN (0 = sin límite)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding SmtpConfig.MaxSendsPerSession, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputStyle}" Height="34"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="LÍMITE POR DÍA (0 = sin límite)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding SmtpConfig.MaxSendsPerDay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputStyle}" Height="34"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Credentials -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="CREDENCIALES" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
                                <TextBlock Text="USUARIO / EMAIL" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding SmtpConfig.Username, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputStyle}" Height="38" Margin="0,0,0,12"/>
                                <TextBlock Text="CONTRASEÑA" Style="{StaticResource FieldLabel}"/>
                                <PasswordBox x:Name="PwdBox" Height="38"
                                             BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                             Padding="12,0" FontSize="13"/>
                            </StackPanel>
                        </Border>

                        <!-- From address -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="NOMBRE REMITENTE" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding SmtpConfig.FromName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputStyle}" Height="38"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="EMAIL REMITENTE" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding SmtpConfig.FromEmail, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputStyle}" Height="38"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <TextBlock Text="NOMBRE CAPTADORA" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding SmtpConfig.CaptadoraNombre, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputStyle}" Height="38"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2">
                                    <TextBlock Text="APELLIDOS CAPTADORA" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding SmtpConfig.CaptadoraApellidos, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputStyle}" Height="38"/>
                                </StackPanel>

                                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
                                    <TextBlock Text="EMAIL REPORTE CIERRE" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding SmtpConfig.CloseReportRecipientEmail, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputStyle}" Height="38"
                                             ToolTip="Email que recibirá automáticamente el reporte de leads al cerrar la aplicación"/>
                                </StackPanel>

                                <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3">
                                    <TextBlock Text="FECHA DESDE REPORTE" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding SmtpConfig.ReportFromDateText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputStyle}" Height="38"
                                             ToolTip="Solo se incluirán leads con fecha de registro igual o posterior. Ejemplo: 25/03/2026"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- WhatsApp contact -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="CONTACTO WHATSAPP" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
                                <TextBlock Text="NÚMERO WHATSAPP (aparecerá en los emails como botón de contacto)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding SmtpConfig.WhatsAppNumber, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputStyle}" Height="38"
                                         ToolTip="Ejemplo: +34600123456 o 600123456. Los números españoles se formatean automáticamente"/>
                                <TextBlock Text="💡 Deja en blanco si no deseas mostrar el botón de WhatsApp en los emails"
                                           FontSize="11" Foreground="#64748B" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="PLANTILLAS POR ETIQUETA (SE AÑADEN AL INICIO DEL EMAIL)" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>

                                <TextBlock Text="INTERESADO" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding SmtpConfig.LabelTemplateInteresado, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextAreaStyle}" Height="70" Margin="0,0,0,8"/>

                                <TextBlock Text="CONFIRMADO" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding SmtpConfig.LabelTemplateConfirmado, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextAreaStyle}" Height="70" Margin="0,0,0,8"/>

                                <TextBlock Text="DESCARTADO" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding SmtpConfig.LabelTemplateDescartado, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextAreaStyle}" Height="70"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="PIE DE EMAIL (SE AÑADE AL FINAL)" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
                                <TextBox Text="{Binding SmtpConfig.EmailFooter, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextAreaStyle}" Height="90"
                                         ToolTip="Ejemplo: datos de la empresa, protección de datos, contacto, etc."/>
                            </StackPanel>
                        </Border>

                        <!-- Buttons + result -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="💾  Guardar configuración" Command="{Binding SaveSmtpCommand}"
                                    Style="{StaticResource BtnPrimary}" Margin="0,0,10,0"/>
                            <Button Content="🔌  Probar conexión" Command="{Binding TestSmtpCommand}"
                                    Style="{StaticResource BtnSecondary}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvBoolVis}}"/>
                            <Button Content="⭳  Descargar reporte"
                                    Command="{Binding DownloadClosingLeadsReportCommand}"
                                    Style="{StaticResource BtnSecondary}" Margin="10,0,0,0"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvBoolVis}}"/>
                            <Button Content="📤  Enviar reporte ahora"
                                    Command="{Binding SendClosingLeadsReportManualCommand}"
                                    Style="{StaticResource BtnSecondary}" Margin="10,0,0,0"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvBoolVis}}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="⚙  Exportar config" Command="{Binding ExportSmtpConfigCommand}"
                                    Style="{StaticResource BtnSecondary}" Margin="0,0,10,0"/>
                            <Button Content="⚙  Importar config" Command="{Binding ImportSmtpConfigCommand}"
                                    Style="{StaticResource BtnSecondary}" Margin="0,0,10,0"/>
                            <Button Content="⭳  Exportar datos" Command="{Binding ExportAppDataCommand}"
                                    Style="{StaticResource BtnSecondary}" Margin="0,0,10,0"/>
                            <Button Content="⭱  Importar datos" Command="{Binding ImportAppDataCommand}"
                                    Style="{StaticResource BtnSecondary}"/>
                        </StackPanel>

                        <Border Background="#F8FAFC" CornerRadius="8" Padding="12,10" Margin="0,0,0,14"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap">
                                ⚙ Exportar/Importar config: solo parámetros de Configuración (SMTP, IA, WhatsApp, etc.).
                                ⭳/⭱ Exportar/Importar datos: copia completa (configuración + cursos + historial + estado comercial).
                            </TextBlock>
                        </Border>

                        <Border CornerRadius="8" Padding="14,10" Margin="0,0,0,14"
                                Visibility="{Binding SmtpTestResult, Converter={StaticResource EmptyStrVis}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#F0FDF4"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SmtpTestResultIsError}" Value="True">
                                            <Setter Property="Background" Value="#FEF2F2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding SmtpTestResult}" FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#166534"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SmtpTestResultIsError}" Value="True">
                                                <Setter Property="Foreground" Value="#991B1B"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <!-- Gmail tip -->
                        <Border Background="#EFF6FF" CornerRadius="10" Padding="18,14"
                                BorderBrush="#BFDBFE" BorderThickness="1" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="💡 Configuración Gmail" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="22"/><RowDefinition Height="22"/>
                                        <RowDefinition Height="22"/><RowDefinition Height="22"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Host:" FontSize="12" Foreground="#64748B" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="smtp.gmail.com" FontSize="12" Foreground="#1E40AF"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Puerto:" FontSize="12" Foreground="#64748B" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="587" FontSize="12" Foreground="#1E40AF"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="SSL:" FontSize="12" Foreground="#64748B" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Activado" FontSize="12" Foreground="#1E40AF"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Contraseña:" FontSize="12" Foreground="#64748B" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Contraseña de aplicación (no la de tu cuenta)"
                                               FontSize="12" Foreground="#1E40AF" TextWrapping="Wrap"/>
                                </Grid>
                                <TextBlock Margin="0,10,0,0" FontSize="12" Foreground="#3730A3" TextWrapping="Wrap">
                                    Ruta Gmail: Seguridad → Verificación en 2 pasos → Contraseñas de aplicación
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- IA — Generación de textos -->
                        <Border CornerRadius="10" Padding="18,16" BorderThickness="1"
                                BorderBrush="#E9D5FF" Background="#FAF5FF">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="✨" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="IA — Generación automática de textos de marketing"
                                               FontSize="13" FontWeight="SemiBold" Foreground="#6B21A8"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Text="PROVEEDOR DE IA" Style="{StaticResource FieldLabel}" Foreground="#7C3AED" Margin="0,0,0,8"/>

                                <!-- OpenRouter card -->
                                <Border CornerRadius="8" Padding="14,12" Margin="0,0,0,8" BorderThickness="2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="#C4B5FD"/>
                                            <Setter Property="Background" Value="White"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SmtpConfig.AiProvider}" Value="OpenRouter">
                                                    <Setter Property="BorderBrush" Value="#7C3AED"/>
                                                    <Setter Property="Background" Value="#F5F3FF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <RadioButton GroupName="AiProvider" Margin="0,0,8,0" VerticalAlignment="Center"
                                                         IsChecked="{Binding SmtpConfig.AiProvider,
                                                             Converter={StaticResource EqStrConverter},
                                                             ConverterParameter=OpenRouter}"/>
                                            <TextBlock Text="OpenRouter — Llama 3.1 8B" FontWeight="Bold"
                                                       FontSize="13" Foreground="#4C1D95" VerticalAlignment="Center"/>
                                            <Border Background="#16A34A" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                                <TextBlock Text="GRATIS" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Sin límite de cuota • openrouter.ai" FontSize="11" Foreground="#7C3AED" Margin="22,0,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Gemini card -->
                                <Border CornerRadius="8" Padding="14,12" Margin="0,0,0,14" BorderThickness="2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="#C4B5FD"/>
                                            <Setter Property="Background" Value="White"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SmtpConfig.AiProvider}" Value="Gemini">
                                                    <Setter Property="BorderBrush" Value="#7C3AED"/>
                                                    <Setter Property="Background" Value="#F5F3FF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <RadioButton GroupName="AiProvider" Margin="0,0,8,0" VerticalAlignment="Center"
                                                         IsChecked="{Binding SmtpConfig.AiProvider,
                                                             Converter={StaticResource EqStrConverter},
                                                             ConverterParameter=Gemini}"/>
                                            <TextBlock Text="Gemini 3 Flash Preview" FontWeight="Bold"
                                                       FontSize="13" Foreground="#4C1D95" VerticalAlignment="Center"/>
                                            <Border Background="#D97706" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                                <TextBlock Text="CUOTA LIMITADA" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="aistudio.google.com" FontSize="11" Foreground="#7C3AED" Margin="22,0,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- OpenRouter Key -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SmtpConfig.AiProvider}" Value="Gemini">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="API KEY — OPENROUTER" Style="{StaticResource FieldLabel}" Foreground="#7C3AED"/>
                                    <TextBox Text="{Binding SmtpConfig.OpenRouterApiKey, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputStyle}" Height="38" Margin="0,0,0,8" BorderBrush="#C4B5FD"/>
                                    <Border Background="#F0FDF4" CornerRadius="7" Padding="10,8">
                                        <TextBlock FontSize="12" Foreground="#166534" TextWrapping="Wrap">
                                            🆓 Completamente gratuito. Regístrate en openrouter.ai → Keys → Create Key. Sin tarjeta de crédito.
                                        </TextBlock>
                                    </Border>
                                </StackPanel>

                                <!-- Gemini Key -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SmtpConfig.AiProvider}" Value="Gemini">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="API KEY — GEMINI" Style="{StaticResource FieldLabel}" Foreground="#7C3AED"/>
                                    <TextBox Text="{Binding SmtpConfig.GeminiApiKey, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputStyle}" Height="38" Margin="0,0,0,8" BorderBrush="#C4B5FD"/>
                                    <Border Background="#FEF3C7" CornerRadius="7" Padding="10,8">
                                        <TextBlock FontSize="12" Foreground="#92400E" TextWrapping="Wrap">
                                            ⚠ El tier gratuito tiene límite de cuota diaria. Obtén la key en aistudio.google.com → Get API Key.
                                        </TextBlock>
                                    </Border>
                                </StackPanel>

                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!-- ─────────────────────────────────────────
                 OVERLAY: Busy spinner
            ───────────────────────────────────────── -->
            <Border Background="#A0000000"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="80" Height="80" Background="#1E293B" CornerRadius="16"
                            HorizontalAlignment="Center" Margin="0,0,0,16">
                        <TextBlock Text="⏳" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Procesando…" FontSize="18" FontWeight="SemiBold"
                               Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="#CBD5E1"
                               HorizontalAlignment="Center" Margin="0,6,0,0" MaxWidth="400"
                               TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>
            </Border>

        </Grid>
    </Grid>
</Window>
